# ── KB증권 OpenAPI 자격증명 (https://developer.kbsec.com 에서 발급) ──
# 둘 다 비워두면 자동으로 "모의(mock) 모드"로 실행됩니다. 절대 커밋하지 마세요.
KB_OPENAPI_APP_KEY=
KB_OPENAPI_APP_SECRET=
KB_OPENAPI_BASE_URL=https://developer.kbsec.com:32484

# ── 실행 모드: mock | live (미지정 시: 키가 있으면 live, 없으면 mock) ──
# KB_MODE=mock

# ── 실거래 안전장치 ──
# live 모드에서 실제 주문(매수/매도/정정)을 허용하려면 true 로 바꾸세요. (취소는 항상 가능)
KB_TRADING_ENABLED=false
# 1회 주문 한도(원). 예상 주문금액이 이 값을 넘으면 서버가 거부합니다.
KB_MAX_ORDER_AMOUNT=5000000
# 주문 API에 보낼 종목코드 형식: short(6자리, 기본) | standard(12자리 표준코드 KR7xxxxxxxxx)
KB_ORDER_CODE_MODE=short

# ── 서버 ──
KB_HOST=127.0.0.1
KB_PORT=8000
# 추가로 허용할 Host 헤더(쉼표 구분). 기본: localhost,127.0.0.1,[::1]
# KB_ALLOWED_HOSTS=
